<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>move_it</AssemblyName>
    <RootNamespace>move_it</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- decompiled/ lives next to the project and must never be compiled. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Override on the command line if the game or the mods folder move:
         dotnet build -p:ParkitectManaged=... -p:ModOutputDir=... -->
    <ParkitectManaged Condition="'$(ParkitectManaged)' == ''">D:\games\steam\steamapps\common\Parkitect\Parkitect_Data\Managed</ParkitectManaged>
    <ModOutputDir Condition="'$(ModOutputDir)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.MyDocuments))\Parkitect\Mods\move_it</ModOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <!-- The game's assemblies target netstandard 2.0. -->
    <Reference Include="netstandard" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Parkitect"><HintPath>$(ParkitectManaged)\Parkitect.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ParkitectManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ParkitectManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ParkitectManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ParkitectManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ParkitectManaged)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- The game loads a single DLL per Mods/<folder> and prefers the one named after the folder,
       so the folder and the assembly must both be called move_it. Sharing to the Workshop uploads this whole folder,
       so only what the mod needs at runtime and on its Workshop page goes here. -->
  <Target Name="CopyToModsFolder" AfterTargets="Build">
    <ItemGroup>
      <_harmony_dll Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == '0Harmony.dll'" />
    </ItemGroup>
    <MakeDir Directories="$(ModOutputDir)" />
    <Copy SourceFiles="$(TargetPath);@(_harmony_dll);workshop\preview.png;workshop\0Harmony.LICENSE.txt" DestinationFolder="$(ModOutputDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="move_it -> $(ModOutputDir)" />
  </Target>

</Project>
